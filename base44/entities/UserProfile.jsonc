{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "name": {
      "type": "string",
      "description": "Full name of the user"
    },
    "company": {
      "type": "string",
      "description": "Company name"
    },
    "team": {
      "type": "string",
      "description": "Team name"
    },
    "interested_resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Resources the user is interested in"
    },
    "interested_areas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Areas the user is interested in"
    },
    "setup_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed initial setup"
    }
  },
  "required": [
    "user_email",
    "name",
    "company",
    "team",
    "interested_resources",
    "interested_areas"
  ]
}