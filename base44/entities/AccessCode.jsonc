{
  "name": "AccessCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "The generated access code"
    },
    "beneficiary_name": {
      "type": "string",
      "description": "Name of the beneficiary"
    },
    "beneficiary_email": {
      "type": "string",
      "description": "Email of the beneficiary"
    },
    "position": {
      "type": "string",
      "description": "Position of the beneficiary"
    },
    "organization": {
      "type": "string",
      "description": "Organization of the beneficiary"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of resource IDs this code grants access to"
    },
    "created_by_admin": {
      "type": "string",
      "description": "Email of the admin who created this code"
    },
    "used_by": {
      "type": "string",
      "description": "Email of the user who used this code"
    },
    "used_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the code was used"
    },
    "is_used": {
      "type": "boolean",
      "default": false,
      "description": "Whether this code has been used"
    }
  },
  "required": [
    "code",
    "resources"
  ]
}