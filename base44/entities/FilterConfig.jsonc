{
  "name": "FilterConfig",
  "type": "object",
  "properties": {
    "config_name": {
      "type": "string",
      "description": "Name of the configuration (e.g., 'published')"
    },
    "filters": {
      "type": "object",
      "description": "Object containing filter categories and their values",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "config_name",
    "filters"
  ]
}