{
  "name": "Assessment",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who completed the assessment"
    },
    "product_name": {
      "type": "string",
      "description": "Name of the product being assessed"
    },
    "scores": {
      "type": "object",
      "description": "Object containing scores for each question"
    },
    "total_score": {
      "type": "number",
      "description": "Total score out of 72"
    },
    "passed": {
      "type": "boolean",
      "description": "Whether the assessment passed (58+ and no critical failures)"
    },
    "critical_failures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of critical sections that failed"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "conditional",
        "fail"
      ],
      "description": "Final decision status"
    }
  },
  "required": [
    "user_email",
    "total_score",
    "passed",
    "status"
  ]
}