{
  "name": "LandingPageConfig",
  "type": "object",
  "properties": {
    "config_name": {
      "type": "string",
      "description": "Name of the configuration (e.g., 'published', 'draft')"
    },
    "sections": {
      "type": "array",
      "description": "Array of sections on the landing page",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "coming_soon": {
            "type": "boolean"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "topics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "icon": {
                  "type": "string"
                },
                "page": {
                  "type": "string"
                },
                "coming_soon": {
                  "type": "boolean"
                },
                "is_coming_soon": {
                  "type": "boolean"
                },
                "featured": {
                  "type": "boolean"
                },
                "published_date": {
                  "type": "string",
                  "format": "date-time"
                },
                "file_url": {
                  "type": "string"
                },
                "cover_image": {
                  "type": "string",
                  "description": "URL of the cover/thumbnail image for this resource"
                },
                "link": {
                  "type": "string"
                },
                "asset_type": {
                  "type": "string",
                  "enum": [
                    "Tools",
                    "Insights",
                    "Playbooks",
                    "Deep dive series"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "config_name"
  ]
}