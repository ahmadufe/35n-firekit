{
  "name": "SaaSMetrics",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "company_name": {
      "type": "string",
      "description": "Company name"
    },
    "industry": {
      "type": "string",
      "description": "Industry"
    },
    "country": {
      "type": "string",
      "description": "Country of operation"
    },
    "metrics_data": {
      "type": "object",
      "description": "Object containing all metric values and comments",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "comments": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "user_email"
  ]
}